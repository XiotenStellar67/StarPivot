{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      // 唯一需要的权限：http/socket 走本机回环与 broker 通信。
      // 1.2.1 起移除 ohos.permission.GET_NETWORK_INFO —— 全工程没有 connection.* 调用，
      // 声明了却不用属于"权限清单不诚实"，也给静态扫描留了多余面。
      {
        "name": "ohos.permission.INTERNET"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:appicon_pivot",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:appicon_pivot",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ]
  }
}
